[Unit]
Description=GLDRUBF independent health check and notification delivery
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=gldrubf
Group=gldrubf
WorkingDirectory=/opt/gldrubf/mx
ExecStart=/usr/bin/python3 -m src.gldrubf_bot.vps check
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredential=alert-token:/etc/gldrubf/alert-token
LoadCredential=alert-chat:/etc/gldrubf/alert-chat
LoadCredential=alert-url:/etc/gldrubf/alert-url
StateDirectory=gldrubf
StateDirectoryMode=0700
UMask=0077
SuccessExitStatus=1
TimeoutStartSec=130
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/gldrubf
StandardOutput=journal
StandardError=journal
